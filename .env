# ============================================================
# خانه بازار — Frontend Environment Variables (Vite)
# ============================================================
# این فایل را در ریشه پروژه فرانت‌اند قرار دهید
# سپس: npm run build
# ============================================================

# آدرس API بک‌اند Node.js
VITE_API_BASE_URL=https://api.khane-bazar-118.ir

# نقشه از OpenStreetMap استفاده می‌کند — رایگان و بدون نیاز به کلید API.

# موارد زیر اختیاری هستند — در صورت نداشتن خالی بگذارید
VITE_KAVENEGAR_API_KEY=
VITE_KAVENEGAR_OTP_TEMPLATE=
VITE_RECAPTCHA_SITE_KEY=u
g=
VITE_PUSHER_CLUSTER=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
